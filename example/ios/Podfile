# Uncomment this line to define a global platform for your project
# 15.0 to match Runner.xcodeproj's IPHONEOS_DEPLOYMENT_TARGET, which has been
# 15.0 for some time — and to satisfy firebase_messaging, which the example
# depends on for the foreign background engine in issue_371_card.dart and whose
# podspec requires 15.0. Tracelet itself is unaffected: tracelet_ios keeps its
# own, lower minimum.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # LOCAL DEV OVERRIDE: use the in-repo TraceletSDK instead of the CocoaPods
  # trunk release, which is not published yet. Uses local source files + the
  # prebuilt sdk/rust-core/out/TraceletCore.xcframework.
  #
  # Must NOT apply whenever the plugins resolve through Swift Package Manager.
  # tracelet_ios/tracelet_sync's Package.swift already depend on the TraceletSDK
  # package at the monorepo root — the same local sources this pod vends — and
  # that package embeds TraceletCore.framework as a binary target. Adding the
  # pod on top embeds a second copy and Xcode fails with "Multiple commands
  # produce …/TraceletCore.framework". Detect SPM by the generated package
  # manifest rather than by ENV['CI']: SPM is the default on Flutter 3.35+, so
  # it is on locally too, not just in GitHub Actions.
  #
  # The podspec-existence check still covers release.yml ("Bundle iOS SDK"),
  # which deletes TraceletSDK.podspec so the example links the bundled plugin.
  spm_manifest = File.expand_path(
    'Flutter/ephemeral/Packages/FlutterGeneratedPluginSwiftPackage/Package.swift', __dir__
  )
  if !File.exist?(spm_manifest) && File.exist?(File.expand_path('../../TraceletSDK.podspec', __dir__))
    pod 'TraceletSDK', :path => '../..'
  end

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # LOCAL DEV: the podspecs force -Wl,-ld_classic, a legacy linker flag
    # removed after Xcode 15. On Xcode 16+/26 it breaks framework symbol
    # resolution (TraceletCore undefined symbols). Strip it here.
    target.build_configurations.each do |config|
      ldflags = config.build_settings['OTHER_LDFLAGS']
      if ldflags.is_a?(Array)
        config.build_settings['OTHER_LDFLAGS'] = ldflags.reject { |f| f == '-ld_classic' || f == '-Wl,-ld_classic' }
      elsif ldflags.is_a?(String)
        config.build_settings['OTHER_LDFLAGS'] = ldflags.gsub('-Wl,-ld_classic', '').gsub('-ld_classic', '')
      end
    end
  end
  # Scrub the generated xcconfig files: (1) drop the removed -ld_classic flag,
  # (2) add -undefined dynamic_lookup so the uniffi_tracelet_core_* symbols in
  # the TraceletSDK bindings resolve at runtime against the embedded
  # TraceletCore.framework (loaded via ExternalLibrary.open) instead of failing
  # at link time.
  Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*.xcconfig')).each do |xc|
    text = File.read(xc)
    new_text = text.gsub(' -Wl,-ld_classic', '').gsub(' -ld_classic', '')
    new_text = new_text.gsub(/^(OTHER_LDFLAGS = .*)$/) do |line|
      line.include?('-undefined dynamic_lookup') ? line : "#{line} -undefined dynamic_lookup"
    end
    File.write(xc, new_text) if new_text != text
  end
end
